<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         metadata-complete="true">

    <display-name>TWPI — индекс сохранности</display-name>

    <servlet>
        <servlet-name>CalcServlet</servlet-name>
        <servlet-class>com.controlj.addon.twpi.servlet.CalcServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CalcServlet</servlet-name>
        <url-pattern>/api/calc</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RoomsServlet</servlet-name>
        <servlet-class>com.controlj.addon.twpi.servlet.RoomsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomsServlet</servlet-name>
        <url-pattern>/api/rooms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CalcAllServlet</servlet-name>
        <servlet-class>com.controlj.addon.twpi.servlet.CalcAllServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CalcAllServlet</servlet-name>
        <url-pattern>/api/all</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RoomDetailServlet</servlet-name>
        <servlet-class>com.controlj.addon.twpi.servlet.RoomDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoomDetailServlet</servlet-name>
        <url-pattern>/api/room</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncludeContentServlet</servlet-name>
        <servlet-class>com.controlj.addon.twpi.servlet.IncludeContentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncludeContentServlet</servlet-name>
        <url-pattern>/include_content</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>IncludeContentServlet</servlet-name>
        <url-pattern>/include_script</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!--
        Статические файлы Tomcat отдаёт без charset, и встроенный браузер WebCTRL
        декодирует их в системной кодировке — кириллица превращается в «ÐŸÐ¾Ð¼…».
        Явный charset в маппинге заставляет отдавать заголовок с UTF-8.
    -->
    <mime-mapping>
        <extension>html</extension>
        <mime-type>text/html;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>htm</extension>
        <mime-type>text/html;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript;charset=UTF-8</mime-type>
    </mime-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
